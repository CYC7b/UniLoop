POSTGRES_USER=uniloop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uniloop
POSTGRES_PORT=5432
DATABASE_URL=postgres://uniloop:change-me@db:5432/uniloop?sslmode=disable

JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
BASE_URL=http://localhost:8080
UPLOAD_DIR=./uploads
ALLOWED_ORIGINS=http://localhost:5173
# Proxies whose X-Forwarded-For is trusted for the client IP (rate limiting).
# Compose defaults to the private ranges nginx reaches the services from; leave
# empty when the Go server faces clients directly (e.g. `make run`).
TRUSTED_PROXIES=

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
OTP_EXPIRY_SECS=600

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379
